<ui:FluentWindow x:Class="LegacyGameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Legacy Game Launcher" Height="820" Width="1240" MinWidth="960" MinHeight="620"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Legacy Game Launcher">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Games24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Library sidebar ============ -->
            <Border Grid.Column="0" Margin="12,4,6,12" Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,10">
                        <TextBlock Text="Library" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Windows 7-era games, tuned for Windows 11" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <ui:Button x:Name="AddGameButton" Content="Add game" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                                   HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="AddGame_Click"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ui:Button x:Name="RemoveGameButton" Content="Remove" Icon="{ui:SymbolIcon Delete24}" HorizontalAlignment="Stretch" Margin="0" Click="RemoveGame_Click"/>
                            <ui:Button Grid.Column="2" Content="Profiles" Icon="{ui:SymbolIcon FolderOpen24}" HorizontalAlignment="Stretch" Margin="0" Click="OpenProfiles_Click"/>
                        </Grid>
                        <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="0,8,0,0" Padding="10" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="UpdateText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ui:Button x:Name="UpdateNowButton" Content="Update now" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0" Click="UpdateNow_Click"/>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,8,0,0">
                            <ui:Button DockPanel.Dock="Right" Content="Check for updates" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0" Click="CheckUpdates_Click"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center" Margin="2,0,8,0"/>
                        </DockPanel>
                        <TextBlock x:Name="ProfileInfo" Style="{StaticResource Hint}" FontSize="11" Margin="2,8,2,0"/>
                    </StackPanel>
                    <ListBox x:Name="GameList" SelectionChanged="GameList_SelectionChanged" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <ui:SymbolIcon Symbol="Games24" FontSize="18" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ExePath}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============ Main area ============ -->
            <Grid Grid.Column="1" Margin="6,4,12,12">
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Games24" FontSize="56" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="No games yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Add a game by selecting its .exe (e.g. Rugby 08 or Cricket 07)." Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                    <ui:Button Content="Add game" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" HorizontalAlignment="Center" Margin="0,8,0,0" Click="AddGame_Click"/>
                </StackPanel>

                <Grid x:Name="Tabs" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <!-- Game header with the Launch button always in reach -->
                    <Border Padding="20,16" CornerRadius="8" Margin="0,0,0,10"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="GameTitle" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LaunchState" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Launch applies the compatibility settings, starts the game and records everything on the Launch tab."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="LaunchButton" Content="Launch" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                                           FontSize="16" FontWeight="SemiBold" Padding="28,10" Margin="0" Click="Launch_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TabControl x:Name="TabHost" Grid.Row="1">

                        <!-- Overview + dependencies + DRM -->
                        <TabItem Header="Overview">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,8,0">
                                    <GroupBox Header="Game">
                                        <TextBox x:Name="OverviewText" Style="{StaticResource Info}"/>
                                    </GroupBox>
                                    <GroupBox Header="Copy protection (detection only - never bypassed)">
                                        <TextBox x:Name="DrmText" Style="{StaticResource Info}"/>
                                    </GroupBox>
                                    <GroupBox Header="Legacy runtime dependencies">
                                        <StackPanel>
                                            <WrapPanel>
                                                <ui:Button Content="Re-check" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="RecheckDeps_Click"/>
                                                <Button Content="DirectX June 2010 (Microsoft)" Click="OpenDxPage_Click"/>
                                                <Button Content="Run DXSETUP.exe…" Click="RunDxSetup_Click"/>
                                                <Button Content="VC++ redistributables (Microsoft)" Click="OpenVcPage_Click"/>
                                            </WrapPanel>
                                            <CheckBox x:Name="ShowAllDeps" Content="Show all checked DLLs (not just problems and ones the game uses)" Checked="ShowAllDeps_Changed" Unchecked="ShowAllDeps_Changed"/>
                                            <TextBlock x:Name="DepAdvice" Style="{StaticResource Hint}"/>
                                            <DataGrid x:Name="DepGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="320" HeadersVisibility="Column" CanUserAddRows="False">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="DLL" Binding="{Binding Dll}" Width="170"/>
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="260"/>
                                                    <DataGridTextColumn Header="Found in" Binding="{Binding Where}" Width="110"/>
                                                    <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- One-click fixes (downloaded from the projects' official GitHub releases) -->
                        <TabItem Header="Fixes">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,8,0">
                                    <TextBlock Style="{StaticResource Hint}" Text="One-click fixes. The launcher downloads each tool from the project's own GitHub release, checks it against the SHA-256 GitHub publishes, keeps it in %LocalAppData%\LegacyGameLauncher\tools and copies the right file into the game folder - with a backup, so Remove restores the original. It never downloads Microsoft files or anything that touches copy protection."/>
                                    <GroupBox Header="Controller crash fix - dinputto8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="For crashes inside Windows' DINPUT.dll (old DirectInput 7 games such as Rugby 08 and Cricket 07), and pads that are misread. Places dinput.dll in the game folder so the game uses DirectInput 8 instead. By Elisha Riedlinger, zlib licence."/>
                                            <TextBlock x:Name="FixDinputStatus" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <WrapPanel>
                                                <ui:Button Content="Download &amp; apply" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Tag="dinputto8" Click="FixApply_Click"/>
                                                <ui:Button Content="Remove" Icon="{ui:SymbolIcon ArrowUndo24}" Tag="dinputto8" Click="FixRemove_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Graphics fix - dgVoodoo2 (recommended for Direct3D 8 games)">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="Runs the game's Direct3D 8/9 on Direct3D 11/12. Uses the settings on the Graphics tab (forced resolution, 60 Hz cap, windowed/borderless, VSync). Fixes many alt-tab, high-refresh and resolution problems. By Dege, freeware."/>
                                            <TextBlock x:Name="FixDgStatus" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <WrapPanel>
                                                <ui:Button Content="Download &amp; apply" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Tag="dgvoodoo2" Click="FixApply_Click"/>
                                                <ui:Button Content="Remove" Icon="{ui:SymbolIcon ArrowUndo24}" Tag="dgvoodoo2" Click="FixRemove_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Graphics fix - DXVK (Vulkan alternative)">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="Runs Direct3D 8/9 on Vulkan. Try it if dgVoodoo2 has problems. Uses the FPS limit and VSync from the Graphics tab. By Philip Rebohle and contributors, zlib licence."/>
                                            <TextBlock x:Name="FixDxvkStatus" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <WrapPanel>
                                                <ui:Button Content="Download &amp; apply" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Tag="dxvk" Click="FixApply_Click"/>
                                                <ui:Button Content="Remove" Icon="{ui:SymbolIcon ArrowUndo24}" Tag="dxvk" Click="FixRemove_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Your own files (mods and fixes you downloaded)">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="Copy files you choose into the game folder - for example a widescreen fix or a mod. Anything replaced is backed up first and every file is listed in Changes &amp; undo, so Remove restores the game folder exactly. The game's own .exe is never replaced."/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Place into subfolder" VerticalAlignment="Center" Width="150"/>
                                                <TextBox x:Name="CustomSubfolder" Width="220"/>
                                                <TextBlock Text="  (blank = next to the game's exe)" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0"/>
                                            </StackPanel>
                                            <WrapPanel>
                                                <ui:Button Content="Add files…" Icon="{ui:SymbolIcon DocumentAdd24}" Appearance="Primary" Click="CustomAddFiles_Click"/>
                                                <ui:Button Content="Add a folder…" Icon="{ui:SymbolIcon FolderAdd24}" Click="CustomAddFolder_Click"/>
                                                <ui:Button Content="Remove all (restore originals)" Icon="{ui:SymbolIcon ArrowUndo24}" Click="CustomRemove_Click"/>
                                            </WrapPanel>
                                            <ListBox x:Name="CustomList" MaxHeight="180" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                            <TextBlock x:Name="CustomEmpty" Style="{StaticResource Hint}" Text="No files of your own added to this game."/>
                                        </StackPanel>
                                    </GroupBox>
                                    <TextBox x:Name="FixLog" Style="{StaticResource Mono}" MinHeight="90" Margin="0,0,0,12"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Compatibility -->
                        <TabItem Header="Compatibility">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,8,0">
                                    <GroupBox Header="Windows compatibility layers">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="Written to HKCU\…\AppCompatFlags\Layers - the same as the exe's Properties › Compatibility tab. Other flags already present (set by Windows or by hand) are preserved."/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Compatibility mode" VerticalAlignment="Center" Width="170"/>
                                                <ComboBox x:Name="OsModeBox" Width="220"/>
                                            </StackPanel>
                                            <CheckBox x:Name="FsoBox" Content="Disable fullscreen optimisations (DISABLEDXMAXIMIZEDWINDOWEDMODE)"/>
                                            <CheckBox x:Name="DpiBox" Content="High-DPI override: application handles scaling (HIGHDPIAWARE)"/>
                                            <CheckBox x:Name="AdminBox" Content="Run as administrator (RUNASADMIN) - asks for UAC on every launch"/>
                                            <CheckBox x:Name="Color16Box" Content="Reduced colour mode 16-bit (16BITCOLOR)"/>
                                            <CheckBox x:Name="Res640Box" Content="Run in 640x480 (640X480)"/>
                                            <CheckBox x:Name="ThemesBox" Content="Disable visual themes (DISABLETHEMES)"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="CPU and process">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Limit to CPU cores" VerticalAlignment="Center" Width="170"/>
                                                <ComboBox x:Name="CoreBox" Width="220"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Process priority" VerticalAlignment="Center" Width="170"/>
                                                <ComboBox x:Name="PriorityBox" Width="220"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Command-line arguments" VerticalAlignment="Center" Width="170"/>
                                                <TextBox x:Name="ArgsBox" Width="340"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AffinityHint" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="SafeDisc loader (one you installed yourself)">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Loader-friendly launch" VerticalAlignment="Center" Width="170"/>
                                                <ComboBox x:Name="LoaderBox" Width="220" SelectionChanged="LoaderBox_Changed">
                                                    <ComboBoxItem Content="Auto"/>
                                                    <ComboBoxItem Content="On"/>
                                                    <ComboBoxItem Content="Off"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <CheckBox x:Name="LoaderCpuBox" Content="Still apply the CPU limit and priority when the loader is active"/>
                                            <TextBlock x:Name="LoaderHint" Style="{StaticResource Hint}"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="When active, no compatibility layers are written for this exe (any layer stops the loader from loading) and existing ones are removed (Undo restores them). The launcher never installs or changes the loader."/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Game disc image (.iso of your own disc)">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <Button Content="Browse…" Margin="0,0,8,0" Click="IsoBrowse_Click"/>
                                                    <ui:Button Content="Mount" Icon="{ui:SymbolIcon Cd16}" Margin="0,0,8,0" Click="IsoMount_Click"/>
                                                    <Button Content="Unmount" Margin="0" Click="IsoUnmount_Click"/>
                                                </StackPanel>
                                                <TextBox x:Name="IsoBox" LostFocus="IsoBox_LostFocus"/>
                                            </DockPanel>
                                            <CheckBox x:Name="IsoMountBox" Content="Mount the image before launching (if it isn't mounted already)" Click="IsoOption_Click"/>
                                            <CheckBox x:Name="IsoUnmountBox" Content="Unmount it when the game exits (only if the launcher mounted it)" Click="IsoOption_Click"/>
                                            <TextBlock x:Name="IsoStatus" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <WrapPanel>
                                        <Button Content="Load recommended" Click="CompatRecommended_Click"/>
                                        <ui:Button Content="Save &amp; apply" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="CompatApply_Click"/>
                                        <ui:Button Content="Undo compatibility changes" Icon="{ui:SymbolIcon ArrowUndo24}" Click="CompatUndo_Click"/>
                                    </WrapPanel>
                                    <TextBox x:Name="CompatStatus" Style="{StaticResource Mono}" MinHeight="70" Margin="0,0,0,12"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Graphics wrapper -->
                        <TabItem Header="Graphics">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,8,0">
                                    <GroupBox Header="Graphics wrapper (optional, you download it)">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="Extract dgVoodoo2 or DXVK yourself. The launcher copies the DLL matching the game's Direct3D version (d3d8.dll for Rugby 08 / Cricket 07) and architecture (x86) plus a config file, backs up anything it replaces, and can remove it cleanly. dgVoodoo2 is usually the better choice here: it can force resolution, cap the refresh rate and run windowed/borderless. DXVK needs 2.4+ for Direct3D 8."/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <RadioButton x:Name="WrapNone" Content="None" GroupName="wrap" Checked="WrapKind_Changed"/>
                                                <RadioButton x:Name="WrapDg" Content="dgVoodoo2 (→ D3D11/12)" GroupName="wrap" Checked="WrapKind_Changed"/>
                                                <RadioButton x:Name="WrapDxvk" Content="DXVK (→ Vulkan)" GroupName="wrap" Checked="WrapKind_Changed"/>
                                            </StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Browse…" Click="WrapBrowse_Click" Margin="8,0,0,0"/>
                                                <TextBlock DockPanel.Dock="Left" Text="Extracted folder" VerticalAlignment="Center" Width="120"/>
                                                <TextBox x:Name="WrapFolder"/>
                                            </DockPanel>
                                            <TextBlock x:Name="WrapSourceInfo" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Display settings">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Text="Forced resolution (0 = off)" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                                <TextBox x:Name="WrapW" Width="90"/><TextBlock Text="  ×  " VerticalAlignment="Center"/><TextBox x:Name="WrapH" Width="90"/>
                                                <Button Content="Use desktop" Margin="8,0,0,0" MinWidth="0" Click="WrapDesktopRes_Click"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="Refresh-rate cap (Hz, 0 = off)" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="WrapHz" Width="90" HorizontalAlignment="Left" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Text="FPS limit (0 = off)" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="WrapFps" Width="90" HorizontalAlignment="Left" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Text="Display mode" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                                <CheckBox x:Name="WrapWindowed" Content="Windowed" Margin="0,0,16,0"/>
                                                <CheckBox x:Name="WrapBorderless" Content="Borderless (full-screen sized window)"/>
                                            </StackPanel>
                                            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="WrapVsync" Content="VSync"/>
                                        </Grid>
                                    </GroupBox>
                                    <WrapPanel>
                                        <Button Content="Load recommended" Click="WrapRecommended_Click"/>
                                        <ui:Button Content="Install / update" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Click="WrapInstall_Click"/>
                                        <ui:Button Content="Remove (restore originals)" Icon="{ui:SymbolIcon ArrowUndo24}" Click="WrapRemove_Click"/>
                                    </WrapPanel>
                                    <TextBox x:Name="WrapStatus" Style="{StaticResource Mono}" MinHeight="90" Margin="0,0,0,12"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Config files -->
                        <TabItem Header="Game config">
                            <Grid Margin="0,12,8,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="200"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="The launcher scans the install folder, the VirtualStore folder, Documents, AppData and LocalAppData (including EA Sports / My Games) plus the registry. Tip: change a setting in-game, then scan again - the most recently modified file is usually the one."/>
                                    <WrapPanel>
                                        <ui:Button Content="Scan" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Click="ConfigScan_Click"/>
                                        <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="ConfigOpenFolder_Click"/>
                                        <CheckBox x:Name="ShowRegistry" Content="Show registry values" VerticalAlignment="Center" Margin="4,0,0,8" Checked="ShowRegistry_Changed" Unchecked="ShowRegistry_Changed"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <DataGrid x:Name="ConfigGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" SelectionChanged="ConfigGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="170"/>
                                            <DataGridTextColumn Header="Where" Binding="{Binding Location}" Width="200"/>
                                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="60"/>
                                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid x:Name="RegistryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Visibility="Collapsed">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="380"/>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                                            <DataGridTextColumn Header="Value (read-only)" Binding="{Binding Value}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                                <StackPanel Grid.Row="2" Margin="0,10,0,4">
                                    <WrapPanel>
                                        <TextBlock Text="Quick set: width" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <TextBox x:Name="CfgW" Width="80" Margin="0,0,8,8"/>
                                        <TextBlock Text="height" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                        <TextBox x:Name="CfgH" Width="80" Margin="0,0,8,8"/>
                                        <ComboBox x:Name="CfgWindowed" Width="150" Margin="0,0,8,8"/>
                                        <Button Content="Apply to detected keys" Click="ConfigQuickSet_Click"/>
                                        <ui:Button Content="Save file" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="ConfigSave_Click"/>
                                        <ui:Button Content="Undo config edits" Icon="{ui:SymbolIcon ArrowUndo24}" Click="ConfigUndo_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="ConfigDetected" Style="{StaticResource Hint}"/>
                                </StackPanel>
                                <TextBox Grid.Row="3" x:Name="ConfigEditor" FontFamily="Cascadia Mono, Consolas" FontSize="12" AcceptsReturn="True" AcceptsTab="True"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,0,0,12"/>
                            </Grid>
                        </TabItem>

                        <!-- Controllers -->
                        <TabItem Header="Controllers">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,12,8,0">
                                    <GroupBox Header="Connected controllers">
                                        <StackPanel>
                                            <WrapPanel><ui:Button Content="Detect controllers" Icon="{ui:SymbolIcon XboxController24}" Appearance="Primary" Click="DetectPads_Click"/></WrapPanel>
                                            <DataGrid x:Name="PadGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="200" Margin="0,0,0,8">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="API" Binding="{Binding Api}" Width="110"/>
                                                    <DataGridTextColumn Header="Controller" Binding="{Binding Name}" Width="240"/>
                                                    <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBox x:Name="PadAdvice" Style="{StaticResource Info}"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Live tester - what an old DirectInput game sees">
                                        <StackPanel>
                                            <WrapPanel>
                                                <ui:Button x:Name="TesterButton" Content="Start tester" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Click="Tester_Click"/>
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="Press buttons and move the sticks. Names match DirectInput (Button N, X/Y, Z, Rx/Ry/Rz). Games from 2007 usually expect the Xbox 360 layout: left stick X/Y, right stick Rx/Ry, triggers on Z, Start = Button 8. A PS4 pad connected directly reports its right stick on Z/Rz, triggers on Rx/Ry and Options = Button 10 - which is why the right stick and pause can do nothing in Rugby 08. With DS4Windows or Steam Input running you should see an Xbox-style controller here too."/>
                                            <StackPanel x:Name="TesterPanel"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Input wrapper (you download it)">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <RadioButton x:Name="PadDinput" Content="dinputto8 (DirectInput 1-7 → 8)" GroupName="pad"/>
                                                <RadioButton x:Name="PadX360" Content="x360ce (XInput emulation)" GroupName="pad"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="dinputto8: for games using legacy dinput.dll that crash in DINPUT.dll or misread modern controllers. x360ce: only when the game expects XInput and your pad is DirectInput-only. The 32-bit build is always used for 32-bit games."/>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Content="Browse…" Click="PadBrowse_Click" Margin="8,0,0,0"/>
                                                <TextBox x:Name="PadFolder"/>
                                            </DockPanel>
                                            <WrapPanel>
                                                <ui:Button Content="Install into game folder" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Click="PadInstall_Click"/>
                                                <ui:Button Content="Remove (restore originals)" Icon="{ui:SymbolIcon ArrowUndo24}" Click="PadRemove_Click"/>
                                            </WrapPanel>
                                            <TextBox x:Name="PadStatus" Style="{StaticResource Mono}" MinHeight="60"/>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Launch & diagnostics -->
                        <TabItem Header="Launch log">
                            <Grid Margin="0,12,8,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Top">
                                        <ui:Button Content="Copy diagnostics" Icon="{ui:SymbolIcon Copy24}" Click="CopyDiag_Click"/>
                                        <ui:Button Content="Save diagnostics…" Icon="{ui:SymbolIcon Save24}" Click="SaveDiag_Click"/>
                                    </WrapPanel>
                                    <TextBox x:Name="LaunchLog" Style="{StaticResource Mono}" TextWrapping="NoWrap"/>
                                </DockPanel>
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="Previous launches" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock DockPanel.Dock="Top" Text="Select one to view its report." Style="{StaticResource Hint}"/>
                                    <ListBox x:Name="LaunchHistory" SelectionChanged="LaunchHistory_SelectionChanged"/>
                                </DockPanel>
                            </Grid>
                        </TabItem>

                        <!-- Undo -->
                        <TabItem Header="Changes &amp; undo">
                            <DockPanel Margin="0,12,8,12">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Style="{StaticResource Hint}" Text="Every change the launcher made for this game, with the original state recorded the first time it touched each file or registry value. Undo restores those originals exactly."/>
                                    <WrapPanel>
                                        <ui:Button Content="Undo selected group" Icon="{ui:SymbolIcon ArrowUndo24}" Click="UndoSelected_Click"/>
                                        <ui:Button Content="Undo ALL changes for this game" Icon="{ui:SymbolIcon ArrowReset24}" Appearance="Caution" Click="UndoAll_Click"/>
                                        <ui:Button Content="Open backups folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenBackups_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                                <TextBox DockPanel.Dock="Bottom" x:Name="UndoLog" Style="{StaticResource Mono}" Height="120" Margin="0,8,0,0"/>
                                <ListBox x:Name="ChangeList"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
